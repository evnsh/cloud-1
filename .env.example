# Domain Configuration
DOMAIN_NAME=cloud1.evan.sh
PMA_DOMAIN=pma.cloud1.evan.sh

# WordPress Database Configuration
WORDPRESS_DB_HOST=mariadb
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wpuser
WORDPRESS_DB_PASSWORD=your_wordpress_db_password

# WordPress Site Configuration
WORDPRESS_SITE_URL=https://cloud1.evan.sh
WORDPRESS_ADMIN_USER=admin
WORDPRESS_ADMIN_PASSWORD=your_admin_password
WORDPRESS_ADMIN_EMAIL=admin@example.com

# MariaDB Configuration
MYSQL_ROOT_PASSWORD=your_root_password
MYSQL_DATABASE=wordpress
MYSQL_USER=wpuser
MYSQL_PASSWORD=your_wordpress_db_password

# phpMyAdmin Configuration
PMA_HOST=mariadb
PMA_BLOWFISH_SECRET=your_32_character_random_string

